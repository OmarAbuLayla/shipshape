# Copy this file to .env (which git ignores) and fill in your key.
# Without a key, Shipshape still runs every check; only the AI explanations are skipped.

# Which LLM service writes the explanations. Supported: deepseek
SHIPSHAPE_LLM_PROVIDER=deepseek

# Which model to use.
#   deepseek-flash   cheapest, fast, good default for development
#   deepseek-v4-pro  stronger reasoning, roughly 2-4x the price
SHIPSHAPE_LLM_MODEL=deepseek-flash

# Your DeepSeek API key (platform.deepseek.com -> API keys). Never commit it.
DEEPSEEK_API_KEY=

# Only change this if DeepSeek tells you to.
DEEPSEEK_BASE_URL=https://api.deepseek.com
