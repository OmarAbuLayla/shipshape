# Copy this file to .env (which git ignores) and fill in your key.
# Without a key, Shipshape still runs every check; only the AI explanations are skipped.
# Check your setup with: shipshape llm-check --ping

# Which LLM service writes the explanations: deepseek, openai or openai-compatible.
# Any service that speaks the OpenAI chat format and supports JSON mode works.
SHIPSHAPE_LLM_PROVIDER=deepseek

# Which model to use. DeepSeek defaults to deepseek-flash (cheapest, a good default);
# for openai and openai-compatible you must set it.
#   deepseek-flash   cheapest, fast
#   deepseek-v4-pro  stronger reasoning, roughly 2-4x the price
SHIPSHAPE_LLM_MODEL=deepseek-flash

# --- deepseek (platform.deepseek.com -> API keys). Never commit a key.
DEEPSEEK_API_KEY=
# Only change this if DeepSeek tells you to.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- openai (platform.openai.com -> API keys)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- openai-compatible: OpenRouter, Mistral, Groq, Together, a local Ollama or vLLM, ...
# SHIPSHAPE_LLM_BASE_URL=https://openrouter.ai/api/v1   (Ollama: http://localhost:11434/v1)
# SHIPSHAPE_LLM_API_KEY=                                 (local servers: any non-empty text)
